#!/usr/bin/env python3
"""Screen job ads from MathJobs and AcademicJobsOnline.

    bin/jobscan                 fetch feeds, write search/scan.csv, print summary
    bin/jobscan --offline       reuse today's cached feeds in search/raw/
    bin/jobscan --show BUCKET   also list the ads in BUCKET (e.g. review, keep)
    bin/jobscan --daily         the daily routine's run (only the routine uses it):
        1. records "Your call" entries (apply/maybe/skip, optionally followed
           by "; because ...") from every dated report in search/reports/
           into decisions.csv; apply also adds a tracker.csv row;
        2. scans the feeds;
        3. moves each report whose ads all have a call into history.md and
           deletes it (ads that vanished from the feeds count as done);
        4. writes search/reports/<today>.md with review ads not already in a
           waiting report (none if there are no new ones);
        5. rewrites search/reports/status.md (last run, waiting reports, open
           maybes, tracked-job changes, deadlines, bucket counts).
    Without --daily nothing is recorded, so the routine is the only writer of
    decisions.csv calls.

Every ad ends up in exactly one bucket with a reason; nothing is dropped.
Mechanical buckets (decided here, from structured feed fields):
    out-country    not US/Canada
    out-type       not a tenure-track position (by the feed's type field)
    out-not-math   AJO ad with no mention of mathematics anywhere
    past-deadline  stated deadline has passed (many still accept applications)
    duplicate      same institution and title already seen on MathJobs
Judgement buckets come from search/decisions.csv (keep, maybe, skip, out-field,
out-elite, out-pay, out-stale, out-other). A remaining ad with no decision
is put in `review`. Missing deadline or salary never excludes an ad.
"""
import csv
import gzip
import html
import json
import re
import sys
import urllib.request
from collections import Counter
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SEARCH = ROOT / "search"
RAW = SEARCH / "raw"
DECISIONS = SEARCH / "decisions.csv"
OUT = SEARCH / "scan.csv"

FEEDS = {
    "mathjobs": "https://www.mathjobs.org/jobs/public_job_boards?limit=5000&page=1",
    "ajo": "https://academicjobsonline.org/ajo/public_job_boards?limit=5000&page=1",
}
COUNTRIES = {"US", "CA"}
TT_TYPES = {"Tenured/Tenure-track faculty", "Open Rank"}
# Types whose ads might still be tenure-track; decided by the ad's wording.
AMBIGUOUS_TYPES = {None, "", "Other", "Teaching stream faculty",
                   "Non-regular rank faculty", "Non tenure-track faculty"}
JUDGEMENT_BUCKETS = {"keep", "maybe", "skip", "out-field", "out-elite", "out-pay",
                     "out-stale", "out-other"}
ELITE = ["Harvard", "Massachusetts Institute of Technology", "Princeton",
         "Stanford", "California Institute of Technology", "Berkeley",
         "University of Chicago", "Columbia University", "Yale",
         "New York University"]


def text(s):
    s = re.sub(r"<[^>]+>", " ", s or "")
    return re.sub(r"\s+", " ", html.unescape(s)).strip()


def load_feed(name, offline):
    RAW.mkdir(parents=True, exist_ok=True)
    path = RAW / f"{name}-{date.today().isoformat()}.json"
    if not offline:
        req = urllib.request.Request(FEEDS[name], headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=120) as r:
            body = r.read()
        if body[:2] == b"\x1f\x8b":   # server gzips even when not asked
            body = gzip.decompress(body)
        path.write_bytes(body)
    data = json.loads(path.read_text())
    if int(data["count"]) != int(data["total_count"]):
        sys.exit(f"{name}: feed returned {data['count']} of {data['total_count']} ads; "
                 "raise the limit")
    return data["results"]


def real_date(s):
    """ISO date from a feed field, or None for empty/0000-00-00/unparseable."""
    s = (s or "")[:10]
    try:
        return date.fromisoformat(s)
    except ValueError:
        return None


def mentions_tenure_track(blob):
    return bool(re.search(r"(?<!non-)(?<!non )tenure[- ]track", blob, re.I))


def salary_hint(ad):
    amounts = re.findall(r"\$\s?\d[\d,]*(?:\.\d+)?\s?[kK]?", ad["salary"] + " " + ad["_text"])
    return " ".join(dict.fromkeys(a.replace(" ", "") for a in amounts))[:80]


def norm(s):
    return re.sub(r"[^a-z0-9]", "", (s or "").lower())


def classify(ad, src, today, seen):
    blob = " ".join([ad["name"] or "", ad["_text"]])
    if ad["country"] not in COUNTRIES:
        return "out-country", ad["country"] or "no country"
    t = ad["type"]
    if t not in TT_TYPES:
        if t in AMBIGUOUS_TYPES and mentions_tenure_track(blob):
            pass
        else:
            return "out-type", f"type={t}"
    if src == "ajo":
        fields = " ".join([ad["subject"] or "", ad["name"] or "", ad["univ"] or "",
                           ad["unit_name"] or "", ad["_text"]])
        if not re.search(r"mathemat", fields, re.I):
            return "out-not-math", f"subject={ad['subject'] or '-'}"
    key = (norm(ad["univ"]), norm(ad["name"]))
    if src != "mathjobs" and key in seen:
        return "duplicate", f"same as {seen[key]}"
    seen.setdefault(key, f"{src}:{ad['id']}")
    dl = real_date(ad["deadline_raw"])
    if dl and dl < today:
        return "past-deadline", f"deadline {dl}"
    return None, ""


def check_tracker(by_url):
    """Open tracker rows whose posting vanished or whose feed deadline moved."""
    out = []
    with open(ROOT / "tracker.csv", newline="") as f:
        for t in csv.DictReader(f):
            if t["status"] in ("rejected", "withdrawn", "closed"):
                continue
            link = t["link"].rstrip("/")
            if "mathjobs.org" not in link and "academicjobsonline.org" not in link:
                continue
            ad = by_url.get(link)
            name = f"{t['institution']} ({t['position']})"
            if ad is None:
                out.append(f"  GONE      {name}: posting no longer in the feed  {link}")
            elif ad["deadline"] != "none" and t["deadline"] and ad["deadline"] != t["deadline"]:
                out.append(f"  DEADLINE  {name}: tracker {t['deadline']}, feed {ad['deadline']}")
    return out


REPORTS = SEARCH / "reports"
HISTORY = REPORTS / "history.md"
STATUS = REPORTS / "status.md"
HISTORY_MARK = "<!-- archived reports below, newest first -->"
CALLS = {"apply": "keep", "keep": "keep", "maybe": "maybe", "skip": "skip"}
OUTCOME = {"keep": "tracker", "maybe": "maybe", "skip": "skip"}


def md(s):
    return (s or "").replace("|", "/").replace("\n", " ").strip()


def link_parts(cell):
    m = re.match(r"\s*\[(.*?)\]\((.*?)\)", cell)
    return (m.group(1), m.group(2)) if m else (cell.strip(), "")


def report_files():
    """Dated reports still waiting in search/reports/ (YYYY-MM-DD.md, YYYY-MM-DD-2.md)."""
    return sorted(p for p in REPORTS.glob("*.md")
                  if re.fullmatch(r"\d{4}-\d{2}-\d{2}(-\d+)?", p.stem))


def read_tables(path):
    """Rows (dicts) of every Markdown table in path that has a Key column."""
    rows, header = [], None
    for line in path.read_text().splitlines():
        if not line.startswith("|"):
            header = None
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if header is None:
            header = cells
        elif "Key" in header and not set("".join(cells)) <= set("-: "):
            rows.append(dict(zip(header, cells)))
    return rows


def parse_call(cell):
    """'skip' or 'skip; because QIS record required' -> ('skip', 'QIS record required').
    Empty -> (None, ''). Anything else -> (first word, rest); caller checks CALLS."""
    cell = cell.strip(" *_—-")
    m = re.match(r"(\w+)\b[\s;:,.-]*(?:because\b\s*)?(.*)", cell)
    return (m.group(1).lower(), m.group(2).strip()) if m else (None, "")


def load_decisions():
    decisions = {}
    if DECISIONS.exists():
        with open(DECISIONS, newline="") as f:
            for row in csv.DictReader(f):
                if row["bucket"] not in JUDGEMENT_BUCKETS:
                    sys.exit(f"decisions.csv: unknown bucket {row['bucket']!r} for {row['key']}")
                decisions[row["key"]] = row
    return decisions


def record_calls(today, decisions):
    """Record 'Your call' entries from every waiting report into decisions.csv
    (and tracker.csv for apply). Updates decisions; returns (recorded, problems)."""
    recorded, problems, new_dec, new_track = [], [], [], []
    for path in report_files():
        for row in read_tables(path):
            key = row.get("Key", "")
            call, why = parse_call(row.get("Your call", ""))
            if not call or key in decisions:
                continue
            inst, url = link_parts(row.get("Institution", ""))
            inst = inst.replace(" (elite list)", "")
            label = f"{inst}, {row.get('Position', '')[:50]}"
            if call not in CALLS:
                problems.append(f"{path.name}, {label}: {row['Your call']!r} not understood "
                                "(use apply, maybe or skip)")
                continue
            note = row.get("Reason", "").strip(" —")
            reason = (f"Joel: {call}" + (f" because {why}" if why else "")
                      + (f"; suggested {row.get('Suggested', '')}: {note}" if note else ""))
            decisions[key] = {"key": key, "bucket": CALLS[call], "reason": reason,
                              "decided": today.isoformat()}
            new_dec.append([key, CALLS[call], reason, today.isoformat()])
            if CALLS[call] == "keep":
                dl = row.get("Deadline", "")
                new_track.append([inst, row.get("Position", ""), dl if real_date(dl) else "",
                                  "interested", "MathJobs" if key.startswith("mathjobs") else "AJO",
                                  url, "", "", "", "" if real_date(dl) else "open until filled"])
            recorded.append(f"{label}: {call} -> {OUTCOME[CALLS[call]]} ({path.name})")
    if new_dec:
        with open(DECISIONS, "a", newline="") as f:
            csv.writer(f, lineterminator="\n").writerows(new_dec)
    if new_track:
        with open(ROOT / "tracker.csv", "a", newline="") as f:
            csv.writer(f, lineterminator="\n").writerows(new_track)
    return recorded, problems


def joel_call(d):
    """The call part of a decisions.csv reason: 'Joel: skip because X; suggested ...' -> 'skip because X'."""
    if d["reason"].startswith("Joel: "):
        return d["reason"][6:].split("; suggested ")[0]
    return f"screened: {d['bucket']}"


def archive_reports(today, decisions, open_keys):
    """Move every waiting report whose ads all have a call (or whose uncalled ads
    are gone from the feeds) into history.md, and delete it. open_keys: keys still
    in `review`, or None if the scan failed (then only called ads count as done)."""
    sections, archived = [], []
    for path in report_files():
        rows = read_tables(path)
        if any(r["Key"] not in decisions and (open_keys is None or r["Key"] in open_keys)
               for r in rows):
            continue
        table = ["| Key | Institution | Position | Deadline | Suggested | Your call | Outcome |",
                 "| --- | --- | --- | --- | --- | --- | --- |"]
        for r in rows:
            d = decisions.get(r["Key"])
            call = md(joel_call(d)) if d else "—"
            outcome = OUTCOME.get(d["bucket"], d["bucket"]) if d else "no call; ad gone or expired"
            table.append(f"| {r['Key']} | {r.get('Institution', '')} | {r.get('Position', '')} | "
                         f"{r.get('Deadline', '')} | {r.get('Suggested', '')} | {call} | {outcome} |")
        sections.append("\n".join([f"## {path.stem} (archived {today})", ""] + table + [""]))
        archived.append(path.name)
        path.unlink()

    old = ""
    if HISTORY.exists() and HISTORY_MARK in HISTORY.read_text():
        old = HISTORY.read_text().split(HISTORY_MARK, 1)[1].strip("\n")
    body = "\n".join(sections[::-1]) + ("\n" + old if old else "")
    HISTORY.write_text("\n".join([
        "# Job ad history", "",
        "Ads from daily reports once every ad in the report had a call. Written by",
        "`bin/jobscan --daily`; don't edit. To change a call, edit `search/decisions.csv`",
        "(and `tracker.csv`), or ask Claude.", "",
        HISTORY_MARK, "", body]).rstrip("\n") + "\n")
    return archived


def all_report_rows():
    """Rows of history.md and of every waiting report."""
    paths = ([HISTORY] if HISTORY.exists() else []) + report_files()
    return [r for p in paths for r in read_tables(p)]


def write_new_report(rows, today, recorded, problems):
    """New dated report with the review ads not already in a waiting report.
    Returns its path, or None if there are no new ads."""
    waiting = {r["Key"] for p in report_files() for r in read_tables(p)}
    new = [r for r in rows if r["bucket"] == "review" and r["key"] not in waiting]
    if not new:
        return None
    path, n = REPORTS / f"{today}.md", 2
    while path.exists():
        path, n = REPORTS / f"{today}-{n}.md", n + 1
    out = [f"# New job ads, {today}", "",
           "Type apply, maybe or skip (optionally \"skip; because ...\") in the \"Your call\"",
           "column, then commit and push. The next morning's scan records your calls; once",
           "every ad here has one, this file moves into history.md. See status.md for",
           "waiting reports, tracked-job changes and deadlines.", ""]
    if recorded or problems:
        out += ["## Recorded since last run", ""]
        out += [f"- {r}" for r in recorded] + [f"- **Not understood:** {p}" for p in problems]
        out.append("")
    out += ["## Ads needing a call", "",
            "| Key | Institution | Position | Place | Deadline | Pay (from ad) | Suggested | Reason | Your call |",
            "| --- | --- | --- | --- | --- | --- | --- | --- | --- |"]
    for r in new:
        elite = " (elite list)" if r["elite_flag"] else ""
        out.append(f"| {r['key']} | [{md(r['institution'])}]({r['url']}){elite} | "
                   f"{md(r['position'])} | {md(r['place'])} | {r['deadline']} | "
                   f"{md(r['salary_hint']) or '—'} | — | — |  |")
    path.write_text("\n".join(out) + "\n")
    return path


def write_status(today, counts, tracker_changes, recorded, problems, archived, new_report,
                 decisions, failure=None):
    out = [f"# Job search status, {today}", "",
           "Rewritten by `bin/jobscan --daily` every morning; don't edit.", ""]
    out += ["## Last run", ""]
    if failure:
        out.append(f"- **Scan failed:** {failure}")
    out += [f"- Recorded: {r}" for r in recorded]
    out += [f"- **Not understood:** {p}" for p in problems]
    out += [f"- Archived to history.md: {a}" for a in archived]
    out.append(f"- New report: {new_report.name}" if new_report else "- No new ads.")
    out.append("")

    out += ["## Reports waiting for your calls", ""]
    waiting = []
    for p in report_files():
        rows = read_tables(p)
        left = sum(1 for r in rows if r["Key"] not in decisions)
        waiting.append(f"- [{p.name}]({p.name}): {left} of {len(rows)} ads still need a call")
    out += waiting or ["None."]
    out.append("")

    maybes = [r for r in all_report_rows() if decisions.get(r["Key"], {}).get("bucket") == "maybe"]
    out += ["## Open maybes", ""]
    if maybes:
        out += ["| Institution | Position | Deadline |", "| --- | --- | --- |"]
        out += [f"| {r['Institution']} | {r['Position']} | {r['Deadline']} |" for r in maybes]
    else:
        out.append("None.")
    out.append("")

    out += ["## Tracked job changes", ""]
    out += [f"- {line.strip()}" for line in tracker_changes] or ["None."]
    out.append("")

    out += ["## Tracker deadlines in the next 30 days", ""]
    soon = []
    with open(ROOT / "tracker.csv", newline="") as f:
        for t in csv.DictReader(f):
            d = real_date(t["deadline"])
            if d and 0 <= (d - today).days <= 30 and t["status"] in ("interested", "preparing"):
                soon.append((d, t))
    if soon:
        out += ["| Deadline | Days | Institution | Position | Status |", "| --- | --- | --- | --- | --- |"]
        for d, t in sorted(soon, key=lambda x: x[0]):
            out.append(f"| {d} | {(d - today).days} | {md(t['institution'])} | "
                       f"{md(t['position'])} | {t['status']} |")
    else:
        out.append("None.")
    out.append("")

    if counts:
        out += ["## Bucket counts", "", "| Bucket | Ads |", "| --- | --- |"]
        out += [f"| {b} | {n} |" for b, n in sorted(counts.items())]
        out += [f"| total | {sum(counts.values())} |", ""]
    STATUS.write_text("\n".join(out))


def scan(decisions, today, offline):
    rows, seen, total = [], {}, 0
    for src in ("mathjobs", "ajo"):   # MathJobs first, so AJO copies are the duplicates
        ads = load_feed(src, offline)
        total += len(ads)
        for ad in ads:
            ad["_text"] = text(ad["description"]) + " " + text(ad["qualifications"])
            ad["salary"] = ad["salary"] or ""
            key = f"{src}:{ad['id']}"
            bucket, reason = classify(ad, src, today, seen)
            if bucket is None:
                d = decisions.get(key)
                bucket, reason = (d["bucket"], d["reason"]) if d else ("review", "")
            elite = next((e for e in ELITE if e.lower() in (ad["univ"] or "").lower()), "")
            rows.append({
                "key": key, "bucket": bucket, "reason": reason,
                "institution": ad["univ"], "position": ad["name"],
                "place": ", ".join(x for x in (ad["city"], ad["state"], ad["country"]) if x),
                "type": ad["type"] or "", "subject": ad["subject"] or "",
                "deadline": str(real_date(ad["deadline_raw"]) or "none"),
                "posted": ad["open_date_raw"] or "",
                "salary": ad["salary"], "salary_hint": salary_hint(ad),
                "elite_flag": elite, "url": ad["url"],
            })
    assert len(rows) == total, "every ad must be in exactly one row"
    return rows


def main():
    today = date.today()
    daily = "--daily" in sys.argv
    offline = "--offline" in sys.argv
    show = sys.argv[sys.argv.index("--show") + 1] if "--show" in sys.argv else None
    decisions = load_decisions()

    recorded, problems = record_calls(today, decisions) if daily else ([], [])
    for r in recorded:
        print(f"recorded: {r}")
    for p in problems:
        print(f"WARNING: not understood: {p}")

    try:
        rows = scan(decisions, today, offline)
    except Exception as e:   # network or feed trouble
        if not daily:
            raise
        failure = f"{type(e).__name__}: {e}"
        print(f"SCAN FAILED: {failure}")
        archived = archive_reports(today, decisions, None)
        write_status(today, {}, [], recorded, problems, archived, None, decisions, failure)
        sys.exit(1)

    unused = set(decisions) - {r["key"] for r in rows}
    rows.sort(key=lambda r: (r["bucket"], r["deadline"], r["institution"]))
    with open(OUT, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=list(rows[0]), lineterminator="\n")
        w.writeheader()
        w.writerows(rows)

    counts = Counter(r["bucket"] for r in rows)
    print(f"{len(rows)} ads -> {OUT.relative_to(ROOT)}")
    for b, n in sorted(counts.items()):
        print(f"  {b:<14}{n:>5}")
    print(f"  {'total':<14}{sum(counts.values()):>5}")
    if unused:
        print(f"\n{len(unused)} decisions match no current ad (expired or removed): "
              + ", ".join(sorted(unused)))
    tracker_changes = check_tracker({r["url"]: r for r in rows})
    if tracker_changes:
        print(f"\n--- tracked jobs that changed ({len(tracker_changes)}) ---")
        for line in tracker_changes:
            print(line)
    if show:
        print(f"\n--- {show} ---")
        for r in rows:
            if r["bucket"] == show:
                print(f"{r['key']:<16}{r['deadline']:<11}{r['institution'][:40]:<41}"
                      f"{r['position'][:55]:<56}{r['place'][:25]:<26}{r['salary_hint'][:30]}"
                      f"{'  [ELITE]' if r['elite_flag'] else ''}  {r['reason']}")
    if daily:
        open_keys = {r["key"] for r in rows if r["bucket"] == "review"}
        archived = archive_reports(today, decisions, open_keys)
        for a in archived:
            print(f"archived: {a} -> history.md")
        new_report = write_new_report(rows, today, recorded, problems)
        print(f"new report: {new_report.relative_to(ROOT)}" if new_report else "no new ads")
        write_status(today, counts, tracker_changes, recorded, problems, archived,
                     new_report, decisions)
        print(f"status -> {STATUS.relative_to(ROOT)}")


if __name__ == "__main__":
    main()
