#!/usr/bin/env bash
# Record your calls from search/reports/latest.md and push them.
#
#     bin/calls
#
# 1. bin/jobscan --ingest: apply/maybe/skip entries in the "Your call" column
#    go to search/decisions.csv (apply also adds a tracker.csv row).
# 2. Commits decisions.csv and tracker.csv (only those files).
# 3. Discards your edits to latest.md: they are recorded now, and the daily
#    scan owns that file, so committing it would only cause conflicts.
# 4. git pull --rebase, then git push.
#
# If an entry isn't understood, it stops before step 2 and nothing is
# discarded: fix the entry and run it again (recorded calls aren't repeated).
set -euo pipefail
cd "$(dirname "$0")/.."

if ! python3 bin/jobscan --ingest; then
    echo "Fix the entries above in search/reports/latest.md and run bin/calls again." >&2
    exit 1
fi

if git diff --quiet HEAD -- search/decisions.csv tracker.csv; then
    echo "Nothing new to commit."
else
    git -c user.name="Joel Villatoro" \
        -c user.email=41701387+JDVillatoro@users.noreply.github.com \
        commit -q -m "Record calls $(date +%F)" -- search/decisions.csv tracker.csv
    echo "Committed decisions.csv and tracker.csv."
fi

git checkout -- search/reports/latest.md
git pull -q --rebase --autostash origin main
git push -q origin main
echo "Pushed. The next morning's scan fills in tracker rows for your applies."
